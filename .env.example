# ==============================================================================
# DULANG INDONESIA - ENVIRONMENT VARIABLES
# ==============================================================================

# Supabase (Opsional - Jika dikosongkan, sistem berjalan otomatis mode Offline/LocalStorage)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Rahasia Server Vercel Serverless (/api/auth-login & /api/qr-hmac)
# PENTING: Hanya atur di Dashboard Vercel / Server Environment — JANGAN pakai prefix VITE_!
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
AUTH_SESSION_SECRET=random-64-char-secret
QR_HMAC_SECRET=random-64-char-secret
